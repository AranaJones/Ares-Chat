{
  "name": "ares-ai-chat",
  "productName": "Ares Chat",
  "version": "1.0.0",
  "description": "Ares desktop chat with local conversation history and simulated assistant replies",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.aresaichat",
    "productName": "Ares Chat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "ares-crypto.js",
      "ares-nodes.js",
      "styles.css",
      "app.js"
    ],
    "mac": {
      "category": "public.app-category.social-networking"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}

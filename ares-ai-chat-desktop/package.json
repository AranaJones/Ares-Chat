{
  "name": "ares-ai-chat-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "hl:check": "haxe --version && hl --version",
    "hl:build-sample": "haxe --cwd tools/hashlink build.hxml",
    "hl:run-sample": "npm run hl:build-sample && hl tools/hashlink/hello.hl"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.ares.chat",
    "productName": "Ares Chat",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}

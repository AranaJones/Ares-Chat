{
  "name": "ares-ai-chat-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.ares.chat",
    "productName": "Ares Chat",
    "icon": "assets/ares-logo.png",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "assets/ares-logo.icns"
    },
    "win": {
      "icon": "assets/ares-logo.ico"
    },
    "linux": {
      "icon": "assets/ares-logo.png"
    },
    "nsis": {
      "installerIcon": "assets/ares-logo.ico",
      "uninstallerIcon": "assets/ares-logo.ico",
      "installerHeaderIcon": "assets/ares-logo.ico"
    }
  }
}

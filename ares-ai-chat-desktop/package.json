{
  "name": "ares-chat",
  "productName": "Ares Chat",
  "version": "1.1.0",
  "description": "A retro Ares Galaxy-style chatroom with an LLM-powered chat participant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.areschat",
    "productName": "Ares Chat",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "ares-crypto.js", "ares-nodes.js", "assets/**/*"],
    "mac": { "category": "public.app-category.social-networking" },
    "win": { "target": "nsis", "icon": "assets/ares-galaxy-icon.ico" },
    "linux": { "target": "AppImage", "icon": "assets/ares-galaxy-icon.png" }
  }
}

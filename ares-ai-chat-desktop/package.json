{
  "name": "ares-ai-chat",
  "productName": "Ares AI Chat",
  "version": "1.1.0",
  "description": "A retro Ares Galaxy-style chatroom with an LLM-powered chat participant",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.aresaichat",
    "productName": "Ares AI Chat",
    "artifactName": "Ares.AI.Chat.Setup.${version}.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "ares-crypto.js", "ares-nodes.js"],
    "mac": { "category": "public.app-category.social-networking" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}

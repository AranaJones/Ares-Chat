{
  "name": "ares-ai-chat-desktop",
  "version": "1.0.0",
  "description": "Retro-inspired Electron desktop chat client for Ares Chat channels.",
  "author": "AranaJones",
  "license": "UNLICENSED",
  "main": "main.js",
  "homepage": "https://github.com/AranaJones/Ares-Chat",
  "bugs": {
    "url": "https://github.com/AranaJones/Ares-Chat/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AranaJones/Ares-Chat.git"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.ares.chat",
    "productName": "Ares Chat",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "ares-crypto.js",
      "ares-nodes.js",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AranaJones",
        "repo": "Ares-Chat"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "assets/ares-logo.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
